# Public
NEXT_PUBLIC_SITE_URL=https://lakshan.me

# YouTube Data API (server-only)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID_LAKZJOURNEY=
YOUTUBE_CHANNEL_ID_LAKSHAN=

# Meta Graph API (server-only)
# Use a long-lived Page access token (usually starts with EAA...), NOT the numeric App ID.
META_ACCESS_TOKEN=
# Instagram Business / Creator account IDs linked to your Facebook Page
META_IG_USER_ID_LAKZJOURNEY=
META_IG_USER_ID_LAKSHAN=
# Facebook Page ID for LakzJourney (optional)
META_FB_PAGE_ID_LAKZJOURNEY=

# TikTok API (server-only) — optional until configured
TIKTOK_ACCESS_TOKEN=
